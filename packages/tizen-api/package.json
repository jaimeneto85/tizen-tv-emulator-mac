        "test": "vitest run"
    },
    "dependencies": {
        "@tvemu/protocol": "workspace:*"
    },
    "devDependencies": {
        "@types/jsdom": "^21.1.7",
        "esbuild": "^0.21.5",
        "jsdom": "^25.0.1"
    }
}
